# Developer Mode - Example (copy to .env.development and fill real keys)
# This file is safe to commit, real .env.development is hidden (attrib +h) and gitignored
ENV=development
DEVELOPER_MODE=true
SQL_INJECTION_PROTECTION=false
DEBUG=true
OPENAI_API_KEY=sk-xxx-your-key
GITHUB_TOKEN=ghp_xxx-your-token-for-private-repos
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/repoatlas
QDRANT_URL=http://localhost:6333
CLERK_SECRET=sk_test_xxx
REDIS_URL=redis://localhost:6379
